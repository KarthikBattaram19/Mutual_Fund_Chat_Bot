# Groq LLM (required for /api/ask generation)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local BGE embeddings (downloaded automatically on first ingestion)
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5

# ChromaDB vector index directory (created by scripts/ingest_corpus.py)
VECTOR_STORE_PATH=data/vector_store

# Retrieval tuning
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# FastAPI backend
API_HOST=127.0.0.1
API_PORT=8000

# CORS: origin of the static UI (python -m http.server 3000 --directory ui)
FRONTEND_ORIGIN=http://localhost:3000
