# Groq LLM (required for /api/ask generation)
# Use llama-3.1-8b-instant for faster factual answers in production.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Local BGE embeddings (downloaded automatically on first ingestion)
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5

# ChromaDB vector index directory (created by scripts/ingest_corpus.py)
VECTOR_STORE_PATH=data/vector_store

# Retrieval tuning
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# FastAPI backend (Railway)
API_HOST=127.0.0.1
API_PORT=8000

# CORS: comma-separated allowed frontend origins (set your Vercel URL on Railway)
# Example: https://mutual-fund-chat-bot.vercel.app,https://mutual-fund-chat-bot-git-main.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Set true only for local single-server mode (API serves frontend/ folder). False for Vercel + Railway.
SERVE_UI=false

# Vercel build variable (set in Vercel dashboard, not in Railway)
# API_BASE_URL=https://your-railway-app.up.railway.app
